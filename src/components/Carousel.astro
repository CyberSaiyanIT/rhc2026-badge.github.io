---
interface Slide {
  title: string;
  svg: string;
  lead: string;
  text: string;
}
interface Props {
  slides: Slide[];
  label: string;
}
const { slides, label } = Astro.props;
const total = slides.length;
---

<div class="mx-auto w-full max-w-xl" data-carousel>
  <div class="relative overflow-hidden rounded-2xl border-2 border-black bg-white text-black">
    <div
      class="absolute right-3 top-3 z-10 rounded-full bg-black/80 px-3 py-1 text-xs font-bold text-white"
      data-carousel-count
      aria-live="polite"
    >
      1 / {total}
    </div>
    <button
      type="button"
      class="absolute left-2 top-[28%] z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/80 text-white transition hover:bg-black disabled:pointer-events-none disabled:opacity-0"
      aria-label="Previous slide"
      data-carousel-prev
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button
      type="button"
      class="absolute right-2 top-[28%] z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/80 text-white transition hover:bg-black disabled:pointer-events-none disabled:opacity-0"
      aria-label="Next slide"
      data-carousel-next
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>

    <div
      class="flex cursor-grab snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      tabindex="0"
      role="group"
      aria-roledescription="carousel"
      aria-label={label}
      data-carousel-track
    >
      {
        slides.map((s, i) => (
          <article
            class="flex shrink-0 basis-full snap-start select-none flex-col gap-4 p-4 sm:p-5"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
          >
            <div class="flex items-center gap-3 pr-14">
              <div class="display flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-accent text-2xl text-white">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="display text-xl sm:text-2xl">{s.title}</h3>
            </div>
            <figure class="pointer-events-none overflow-hidden rounded-xl border-2 border-black leading-[0] [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={s.svg} />
            <div class="flex flex-col gap-1">
              <p class="text-lg font-bold leading-snug">{s.lead}</p>
              <p class="leading-relaxed text-black/75">{s.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <div class="mt-3 flex justify-center gap-2" data-carousel-dots role="tablist" aria-label="Choose a slide"></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const n = slides.length;
    const count = root.querySelector<HTMLElement>('[data-carousel-count]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    const dotsBox = root.querySelector<HTMLElement>('[data-carousel-dots]')!;
    const dots: HTMLButtonElement[] = [];
    let idx = 0;

    for (let i = 0; i < n; i++) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'h-2.5 w-2.5 rounded-full bg-black/20 transition aria-[current=true]:scale-125 aria-[current=true]:bg-accent';
      b.setAttribute('aria-label', `Go to slide ${i + 1}`);
      b.addEventListener('click', () => go(i));
      dotsBox.appendChild(b);
      dots.push(b);
    }

    function go(i: number) {
      i = Math.max(0, Math.min(n - 1, i));
      track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
    }
    function update() {
      const w = track.clientWidth || 1;
      idx = Math.max(0, Math.min(n - 1, Math.round(track.scrollLeft / w)));
      count.textContent = `${idx + 1} / ${n}`;
      prev.disabled = idx === 0;
      next.disabled = idx === n - 1;
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === idx)));
    }

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => {
      track.scrollTo({ left: idx * track.clientWidth });
      update();
    });
    prev.addEventListener('click', () => go(idx - 1));
    next.addEventListener('click', () => go(idx + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(idx + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx - 1); }
    });

    // Mouse drag (touch uses native swipe)
    let down = false, sx = 0, sl = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; sx = e.clientX; sl = track.scrollLeft;
      track.classList.remove('snap-x', 'snap-mandatory', 'cursor-grab');
      track.classList.add('cursor-grabbing');
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (down) track.scrollLeft = sl - (e.clientX - sx);
    });
    const end = () => {
      if (!down) return;
      down = false;
      track.classList.add('snap-x', 'snap-mandatory', 'cursor-grab');
      track.classList.remove('cursor-grabbing');
      const w = track.clientWidth;
      track.scrollTo({ left: Math.round(track.scrollLeft / w) * w, behavior: 'smooth' });
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);

    update();
  });
</script>
