---
---

<figure class="overflow-hidden rounded-xl border-2 border-black leading-[0]">
  <svg viewBox="0 0 760 420" class="block h-auto w-full" role="img" aria-label="Close-up of the badge: hold the BOOT button while tapping RESET, then release BOOT">
    <rect width="760" height="420" fill="#C0392F"></rect>
    <path d="M0 360 L140 420 M0 310 L70 420" stroke="#141413" stroke-width="12" fill="none"></path>

    <!-- ESP32 module -->
    <rect x="40" y="86" width="290" height="250" rx="6" fill="#141413"></rect>
    <rect x="52" y="98" width="266" height="180" rx="4" fill="#b9b6ae"></rect>
    <rect x="74" y="118" width="64" height="64" fill="#fff"></rect>
    <path d="M80 124h8v8h-8zM96 124h8v8h-8zM112 124h8v8h-8zM80 140h8v8h-8zM104 140h8v8h-8zM122 148h8v8h-8zM88 156h8v8h-8zM112 164h8v8h-8zM80 168h8v8h-8z" fill="#141413"></path>
    <text x="185" y="228" text-anchor="middle" fill="#141413" font-family="Lato, sans-serif" font-weight="900" font-size="20">ESP32-S3-WROOM-1</text>
    <text x="185" y="252" text-anchor="middle" fill="#141413" font-family="Lato, sans-serif" font-weight="700" font-size="14">ESPRESSIF</text>
    <path d="M70 300h240M70 316h240" stroke="#3a3a38" stroke-width="4" fill="none"></path>

    <!-- BOOT -->
    <rect x="410" y="86" width="120" height="120" rx="14" fill="#F4F1EA" stroke="#141413" stroke-width="4"></rect>
    <circle cx="470" cy="146" r="34" fill="#fff" stroke="#b9b6ae" stroke-width="4"></circle>
    <text x="470" y="232" text-anchor="middle" fill="#F4F1EA" font-family="Evogria, Lato, sans-serif" font-weight="900" font-size="22">BOOT</text>
    <circle cx="470" cy="146" r="56" fill="none" stroke="#E80B60" stroke-width="6" stroke-dasharray="10 8">
      <animate attributeName="stroke-dashoffset" from="0" to="-36" dur="1.2s" repeatCount="indefinite"></animate>
    </circle>

    <!-- RESET -->
    <rect x="410" y="250" width="120" height="86" rx="14" fill="#F4F1EA" stroke="#141413" stroke-width="4"></rect>
    <circle cx="470" cy="293" r="24" fill="#fff" stroke="#b9b6ae" stroke-width="4"></circle>
    <text x="470" y="366" text-anchor="middle" fill="#F4F1EA" font-family="Evogria, Lato, sans-serif" font-weight="900" font-size="22">RESET</text>

    <!-- steps -->
    <g font-family="Lato, sans-serif" font-weight="700" font-size="17">
      <circle cx="596" cy="118" r="17" fill="#E80B60"></circle>
      <text x="596" y="124" text-anchor="middle" fill="#fff" font-weight="900">1</text>
      <text x="624" y="124" fill="#fff">Hold BOOT</text>
      <circle cx="596" cy="180" r="17" fill="#E80B60"></circle>
      <text x="596" y="186" text-anchor="middle" fill="#fff" font-weight="900">2</text>
      <text x="624" y="186" fill="#fff">Tap RESET</text>
      <circle cx="596" cy="242" r="17" fill="#E80B60"></circle>
      <text x="596" y="248" text-anchor="middle" fill="#fff" font-weight="900">3</text>
      <text x="624" y="248" fill="#fff">Release BOOT</text>
    </g>
    <rect x="574" y="284" width="170" height="52" rx="26" fill="#141413"></rect>
    <circle cx="600" cy="310" r="8" fill="#3ddc84"></circle>
    <text x="618" y="316" fill="#F4F1EA" font-family="Lato, sans-serif" font-weight="700" font-size="15">Bootloader mode</text>
  </svg>
</figure>
