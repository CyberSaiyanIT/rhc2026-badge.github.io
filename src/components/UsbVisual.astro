---
---

<figure class="overflow-hidden rounded-xl border-2 border-black leading-[0]">
  <svg viewBox="0 0 760 420" class="block h-auto w-full" role="img" aria-label="A USB-C cable connects the computer to the USB-C port on the left edge of the badge">
    <rect width="760" height="420" fill="#1c1b1a"></rect>

    <!-- computer -->
    <rect x="22" y="112" width="132" height="86" rx="8" fill="#2c2b2a" stroke="#b9b6ae" stroke-width="4"></rect>
    <rect x="34" y="124" width="108" height="62" rx="3" fill="#3f6fc4"></rect>
    <text x="88" y="162" text-anchor="middle" fill="#fff" font-family="Evogria, Lato, sans-serif" font-weight="900" font-size="16">YOUR PC</text>
    <path d="M6 208 H170 L160 224 H16 Z" fill="#b9b6ae"></path>

    <!-- badge (back) -->
    <rect x="270" y="36" width="470" height="348" rx="20" fill="#C0392F"></rect>
    <path d="M270 56 a20 20 0 0 1 20 -20 H720 a20 20 0 0 1 20 20 V104 H270 Z" fill="#141413"></path>
    <ellipse cx="380" cy="168" rx="38" ry="48" fill="#141413"></ellipse>
    <circle cx="380" cy="160" r="24" fill="#b9b6ae"></circle>
    <rect x="520" y="140" width="90" height="120" rx="3" fill="#E5A02B"></rect>
    <rect x="512" y="140" width="12" height="120" fill="#F4F1EA"></rect>
    <rect x="470" y="296" width="120" height="64" rx="4" fill="#b9b6ae"></rect>
    <text x="530" y="334" text-anchor="middle" fill="#141413" font-family="Lato, sans-serif" font-weight="700" font-size="13">ESP32-S3</text>
    <rect x="590" y="296" width="24" height="64" fill="#141413"></rect>
    <rect x="650" y="300" width="70" height="60" rx="4" fill="#b9b6ae"></rect>
    <text x="685" y="336" text-anchor="middle" fill="#141413" font-family="Lato, sans-serif" font-weight="700" font-size="12">microSD</text>

    <!-- USB-C port -->
    <rect x="270" y="196" width="34" height="52" rx="6" fill="#b9b6ae" stroke="#F4F1EA" stroke-width="3"></rect>
    <rect x="278" y="210" width="18" height="24" rx="4" fill="#141413"></rect>
    <circle cx="287" cy="222" r="46" fill="none" stroke="#E80B60" stroke-width="6">
      <animate attributeName="r" values="40;54;40" dur="2s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="1;0.2;1" dur="2s" repeatCount="indefinite"></animate>
    </circle>
    <text x="330" y="266" fill="#F4F1EA" font-family="Lato, sans-serif" font-weight="700" font-size="16">USB-C port</text>

    <!-- cable + plug -->
    <path d="M154 190 C200 190 190 222 214 222 H236" fill="none" stroke="#000" stroke-width="10" stroke-linecap="round"></path>
    <path d="M154 190 C200 190 190 222 214 222 H236" fill="none" stroke="#F4F1EA" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 14"></path>
    <rect x="234" y="208" width="42" height="28" rx="8" fill="#141413" stroke="#b9b6ae" stroke-width="3"></rect>
    <rect x="270" y="212" width="14" height="20" rx="4" fill="#b9b6ae"></rect>
    <path d="M170 262 H236" stroke="#F4F1EA" stroke-width="4" marker-end="url(#ar)" fill="none"></path>
    <text x="170" y="286" text-anchor="middle" fill="#F4F1EA" font-family="Evogria, Lato, sans-serif" font-weight="900" font-size="15">PLUG IN</text>
  </svg>
</figure>
